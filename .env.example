NODE_ENV=development
PORT=8080

API_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

DATABASE_URL=postgresql://dailytaka:dailytaka@localhost:5432/dailytaka

# S3-compatible object storage (MinIO local / R2 / S3 prod) — audio & images
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=dailytaka-media
STORAGE_REGION=us-east-1
