NODE_ENV=development
PORT=8080

API_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Admin listening CUD — Authorization: Bearer … or header x-admin-api-key (until Better Auth admin)
ADMIN_API_KEY=change-me-admin-key-at-least-16-chars

DATABASE_URL=postgresql://dailytaka:dailytaka@localhost:5432/dailytaka

# MinIO (docker compose: minio + minio-init) — listening audio & media
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=dailytaka-media
STORAGE_REGION=us-east-1

# Source MP3 for pnpm db:seed (upload once to MinIO, not stored in repo)
FIRST_SNOW_AUDIO_SOURCE=

# Listening search: ilike (default) or fts (requires search_vector column)
LISTENING_SEARCH_MODE=ilike

# Optional dev fallback: read from data/listening-media/ if object missing (default off)
# ALLOW_LISTENING_LOCAL_MEDIA=true
# LISTENING_MEDIA_DIR=
